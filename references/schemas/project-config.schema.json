{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project Config",
  "type": "object",
  "required": ["project_id", "novel_name", "drama_name", "platform", "genre", "writer_has_final_authority"],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "novel_name": {"type": "string"},
    "drama_name": {"type": "string"},
    "platform": {"type": "string"},
    "aspect_ratio": {"type": "string"},
    "genre": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "initial_episode_count": {"type": "integer", "minimum": 1},
    "minimum_episode_seconds": {"type": "integer", "minimum": 0},
    "minimum_total_seconds": {"type": ["integer", "null"]},
    "preferred_episode_seconds": {"type": ["array", "null"], "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
    "preferred_total_seconds": {"type": ["array", "null"], "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
    "source_scope": {
      "type": "object",
      "properties": {
        "start_chapter": {"type": "integer", "minimum": 1},
        "end_chapter": {"type": "integer", "minimum": 1}
      }
    },
    "reach_original_ending": {"type": "boolean"},
    "fidelity": {"type": "string", "enum": ["strict", "medium", "free"]},
    "dialogue_policy": {"type": "string", "enum": ["prefer_original", "rewrite_ok"]},
    "review_policy": {"type": "string", "enum": ["advisory_with_writer_confirmation", "advisory", "blocking"]},
    "script_format": {"type": "string", "enum": ["default-cn"]},
    "transport_format": {"type": "string", "enum": ["plain", "legacy-scriptitem"]},
    "writer_has_final_authority": {"type": "boolean"},
    "must_keep": {"type": "array", "items": {"type": "string"}},
    "forbidden_changes": {"type": "array", "items": {"type": "string"}},
    "pending_confirmation": {"type": "array", "items": {"type": "string"}},
    "content_distribution_notes": {"type": "array", "items": {"type": "string"}},
    "episode_timing_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start_episode", "end_episode"],
        "properties": {
          "start_episode": {"type": "integer", "minimum": 1},
          "end_episode": {"type": "integer", "minimum": 1},
          "preferred_seconds": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 2, "maxItems": 2},
          "content_weight": {"enum": ["light", "normal", "heavy"]},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "planning_checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["episode", "expectation"],
        "properties": {
          "episode": {"type": "integer", "minimum": 1},
          "expectation": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "entity_aliases": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {"type": "string"},
          {"type": "array", "items": {"type": "string"}}
        ]
      }
    },
    "model_config": {
      "type": "object",
      "properties": {
        "api_url": {"type": "string"},
        "api_key_env": {"type": "string"},
        "model": {"type": "string"}
      }
    },
    "advisory_timing": {
      "type": "object",
      "properties": {
        "dialogue_chars_per_minute": {"type": ["integer", "null"], "minimum": 1},
        "script_total_chars_per_minute_hint": {"type": ["integer", "null"], "minimum": 1},
        "timing_policy": {"type": "string", "enum": ["advisory"]}
      }
    }
  },
  "additionalProperties": true
}
