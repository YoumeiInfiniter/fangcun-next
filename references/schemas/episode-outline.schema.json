{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Episode Outline",
  "type": "object",
  "required": [
    "episode",
    "title",
    "source_event_ids",
    "source_chapters",
    "opening_bridge",
    "episode_goal",
    "must_keep",
    "causal_chains",
    "knowledge_at_start",
    "knowledge_at_end",
    "ending_hook"
  ],
  "properties": {
    "episode": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "source_event_ids": {"type": "array", "items": {"type": "string"}},
    "source_chapters": {"type": "array", "items": {"type": "integer"}},
    "opening_bridge": {"type": "string"},
    "episode_goal": {"type": "string", "minLength": 1},
    "episode_focus": {"type": "string", "minLength": 1},
    "must_keep": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "required": ["text"],
            "properties": {
              "text": {"type": "string", "minLength": 1},
              "event_id": {"type": "string", "minLength": 1},
              "adaptation_decision_id": {"type": "string", "minLength": 1},
              "legacy_classification": {"type": "string", "enum": ["legacy_unspecified"]}
            },
            "additionalProperties": true
          }
        ]
      },
      "minItems": 1
    },
    "required_story_beats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "event_ids": {"type": "array", "items": {"type": "string"}},
          "adaptation_decision_id": {"type": "string", "minLength": 1},
          "priority": {"type": "string", "enum": ["core", "supporting"]}
        },
        "additionalProperties": true
      }
    },
    "required_quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["quote", "source_event_id"],
        "properties": {
          "quote": {"type": "string", "minLength": 1},
          "source_event_id": {"type": "string", "minLength": 1},
          "pair_id": {"type": "string", "minLength": 1},
          "setup": {"type": "string", "minLength": 1},
          "payoff": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "project_rule_refs": {"type": "array", "items": {"type": "string"}},
    "optional_beats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "event_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "beat_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["beat_id", "function"],
        "properties": {
          "beat_id": {"type": "string", "minLength": 1},
          "function": {"type": "string", "minLength": 1},
          "event_ids": {"type": "array", "items": {"type": "string"}},
          "priority": {"type": "string", "enum": ["core", "supporting", "optional"]},
          "presentation": {"type": "string", "enum": ["full", "condensed", "deferred"]},
          "estimated_seconds": {
            "type": "array",
            "items": {"type": "integer", "minimum": 0},
            "minItems": 2,
            "maxItems": 2
          },
          "entry_state": {"type": "string"},
          "visible_outcome": {"type": "string"},
          "required_visual_beats": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "overflow_options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["beat_id", "allowed_actions"],
        "properties": {
          "beat_id": {"type": "string", "minLength": 1},
          "allowed_actions": {
            "type": "array",
            "items": {"type": "string", "enum": ["compress", "defer", "accept_overflow"]}
          }
        },
        "additionalProperties": true
      }
    },
    "causal_chains": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {"type": "string"},
        "minItems": 2
      },
      "minItems": 1
    },
    "knowledge_at_start": {"type": "object"},
    "knowledge_at_end": {"type": "object"},
    "dialogue_anchors": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "quote", "source_event_id"],
            "properties": {
              "type": {"const": "quote"},
              "quote": {"type": "string", "minLength": 1},
              "source_event_id": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["type", "setup", "payoff", "source_event_id"],
            "properties": {
              "type": {"const": "pair"},
              "setup": {"type": "string", "minLength": 1},
              "payoff": {"type": "string", "minLength": 1},
              "source_event_id": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["payoff", "source"],
            "properties": {
              "setup": {"type": ["string", "null"]},
              "payoff": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "allowed_compression": {"type": "array", "items": {"type": "string"}},
    "forbidden_additions": {"type": "array", "items": {"type": "string"}},
    "ending_hook": {"type": "string", "minLength": 1},
    "suggested_seconds": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
    "writer_notes": {"type": "array", "items": {"type": "string"}},
    "episode_function": {"type": "array", "items": {"type": "string"}},
    "adaptation_basis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "anyOf": [
    {"properties": {"source_event_ids": {"minItems": 1}}},
    {"properties": {"source_chapters": {"minItems": 1}}},
    {"required": ["adaptation_basis"], "properties": {"adaptation_basis": {"minItems": 1}}},
    {"properties": {"required_story_beats": {"minItems": 1}}},
    {"properties": {"required_quotes": {"minItems": 1}}},
    {"properties": {"beat_plan": {"minItems": 1}}}
  ],
  "additionalProperties": true
}
