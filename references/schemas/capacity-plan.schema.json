{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Capacity Plan",
  "type": "object",
  "required": [
    "plan_schema_version",
    "priority_mode",
    "coverage_mode",
    "episode_count",
    "episode_seconds",
    "event_partition",
    "compressible_event_ids",
    "deferred_event_ids",
    "omitted_event_ids",
    "forecast_version",
    "forecast_hash",
    "status",
    "writer_confirmation_ref"
  ],
  "properties": {
    "plan_schema_version": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "plan_version": {"type": "string", "minLength": 1},
    "priority_mode": {"type": "string", "enum": ["quality_first", "fixed_episode_count", "fixed_episode_duration"]},
    "coverage_mode": {"type": "string", "enum": ["mainline", "balanced", "full"]},
    "coverage_policy": {"type": "string", "enum": ["mainline", "balanced", "full"]},
    "episode_count": {"type": "integer", "minimum": 1},
    "episode_seconds": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 2, "maxItems": 2},
    "selected_episode_count": {"type": "integer", "minimum": 1},
    "selected_episode_seconds": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 2, "maxItems": 2},
    "event_partition": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "kept_event_ids": {"type": "array", "items": {"type": "string"}},
    "compressible_event_ids": {"type": "array", "items": {"type": "string"}},
    "compressed_event_ids": {"type": "array", "items": {"type": "string"}},
    "deferred_event_ids": {"type": "array", "items": {"type": "string"}},
    "omitted_event_ids": {"type": "array", "items": {"type": "string"}},
    "accepted_overflow_episodes": {"type": "array", "items": {"type": "integer", "minimum": 1}},
    "overflow_action": {"type": "string", "enum": ["full", "compress", "defer", "accept_overflow", "omit"]},
    "rationale": {"type": "string"},
    "forecast_version": {"type": "string", "minLength": 1},
    "forecast_hash": {"type": "string", "minLength": 32},
    "outline_version": {"type": ["string", "null"]},
    "outline_hash": {"type": ["string", "null"]},
    "status": {"type": "string", "enum": ["proposed", "approved", "superseded"]},
    "writer_confirmation_ref": {"type": "string", "minLength": 1},
    "confirmation_operator": {"type": "string"},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "advisory_only": {"type": "boolean"}
  },
  "additionalProperties": true
}
