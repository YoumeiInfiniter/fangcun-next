{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Review Report",
  "type": "object",
  "required": ["episode", "verdict", "summary", "issues", "context_hash", "draft_hash", "draft_version"],
  "properties": {
    "episode": {"type": "integer", "minimum": 1},
    "context_hash": {"type": "string", "minLength": 32},
    "draft_hash": {"type": "string", "minLength": 32},
    "draft_version": {"type": "string", "minLength": 1},
    "verdict": {"type": "string", "enum": ["pass", "warning", "blocked"]},
    "summary": {"type": "string", "minLength": 1},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "category", "problem"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "enum": ["error", "warning", "suggestion"]},
            "category": {"type": "string", "enum": [
            "source_fidelity",
            "outline_adherence",
            "causality",
            "character_knowledge",
            "dialogue_pairing",
            "character_voice",
            "previous_episode_bridge",
            "ending_hook",
            "continuity",
            "shootability",
            "timing",
            "format",
            "other",
            "transition"
          ]},
          "location": {"type": "string"},
          "problem": {"type": "string", "minLength": 1},
          "source_evidence": {"type": "string"},
          "adaptation_basis": {"type": "string"},
          "evidence": {
            "type": "object",
            "properties": {
              "evidence_type": {"type": "string", "enum": ["source", "adaptation"]},
              "event_id": {"type": "string"},
              "chapter_id": {"type": "integer"},
              "source_span": {
                "type": "object",
                "properties": {
                  "start": {"type": "integer", "minimum": 0},
                  "end": {"type": "integer", "minimum": 0}
                }
              },
              "excerpt_hash": {"type": "string"},
              "quote": {"type": "string"},
              "adaptation_decision_id": {"type": "string"}
            }
          },
          "fix": {"type": "string"}
        }
      }
    },
    "timing_advisory": {
      "type": "object",
      "properties": {
        "estimated_seconds": {"type": ["number", "null"], "minimum": 0},
        "estimated_range": {"type": ["array", "null"], "items": {"type": "number"}},
        "preferred_seconds": {"type": ["array", "null"], "items": {"type": "integer"}},
        "deviation": {"type": ["string", "null"], "enum": ["below", "within", "above", "unknown"]},
        "blocking": {"type": "boolean"}
      }
    },
    "writer_decision_required": {"type": "boolean"},
    "review_contract_version": {"type": "string"},
    "beat_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["beat_id", "status", "causality_complete", "dialogue_chain_complete", "visible_reaction_present", "required_visuals_present", "draft_evidence", "severity", "fix"],
        "properties": {
          "beat_id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["dramatized", "summarized", "missing", "not_applicable"]},
          "causality_complete": {"type": "boolean"},
          "dialogue_chain_complete": {"type": "boolean"},
          "visible_reaction_present": {"type": "boolean"},
          "required_visuals_present": {"type": "boolean"},
          "draft_evidence": {
            "type": "object",
            "required": ["line_start", "line_end", "artifact_quote"],
            "properties": {
              "line_start": {"type": "integer", "minimum": 1},
              "line_end": {"type": "integer", "minimum": 1},
              "artifact_quote": {"type": "string", "minLength": 1}
            }
          },
          "severity": {"type": "string", "enum": ["error", "warning", "suggestion", "none"]},
          "fix": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "dimension_checks": {"type": ["array", "object"]},
    "risk_signal_checks": {"type": ["array", "object"]},
    "context_hash": {"type": "string"},
    "reviewer": {"type": "string"}
  },
  "additionalProperties": true
}
