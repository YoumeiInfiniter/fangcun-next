{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Source Event",
  "type": "object",
  "required": ["event_id", "chapter_id", "event"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "chapter_id": {"type": "integer", "minimum": 1},
    "chapter_title": {"type": "string"},
    "source_span": {
      "type": "object",
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0}
      }
    },
    "characters": {"type": "array", "items": {"type": "string"}},
    "event": {"type": "string", "minLength": 1},
    "trigger": {"type": "string"},
    "actions": {"type": "array", "items": {"type": "string"}},
    "result": {"type": "string"},
    "required_reactions": {"type": "array", "items": {"type": "string"}},
    "knowledge_changes": {"type": "object"},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "payoffs": {"type": "array", "items": {"type": "string"}},
    "key_quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["speaker", "text"],
        "properties": {
          "speaker": {"type": "string"},
          "text": {"type": "string"},
          "must_preserve_pairing": {"type": "boolean"},
          "pair_id": {"type": "string"},
          "setup": {"type": "string"},
          "payoff": {"type": "string"}
        }
      }
    },
    "importance": {"type": "string", "enum": ["mainline", "subline", "transition"]},
    "minimum_screen_seconds": {"type": "integer", "minimum": 0},
    "preferred_screen_seconds": {"type": ["integer", "null"], "minimum": 0},
    "adaptation_options": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "additionalProperties": true
}
