{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Draft Metrics",
  "type": "object",
  "required": [
    "episode",
    "context_hash",
    "draft_version",
    "draft_hash",
    "estimator_version",
    "dialogue_chars",
    "action_chars",
    "action_lines",
    "scene_count",
    "reaction_count",
    "estimated_seconds",
    "estimated_range",
    "preferred_seconds",
    "deviation",
    "blocking"
  ],
  "properties": {
    "episode": {"type": "integer", "minimum": 1},
    "context_hash": {"type": "string", "minLength": 32},
    "draft_version": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "draft_hash": {"type": "string", "minLength": 32},
    "estimator_version": {"type": "string", "minLength": 1},
    "dialogue_chars": {"type": "integer", "minimum": 0},
    "action_chars": {"type": "integer", "minimum": 0},
    "action_lines": {"type": "integer", "minimum": 0},
    "scene_count": {"type": "integer", "minimum": 0},
    "reaction_count": {"type": "integer", "minimum": 0},
    "estimated_seconds": {"type": "number", "minimum": 0},
    "estimated_range": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "preferred_seconds": {"type": ["array", "null"], "items": {"type": "integer"}},
    "deviation": {"type": "string", "enum": ["below", "within", "above", "unknown"]},
    "blocking": {"type": "boolean"},
    "source": {"type": "string", "enum": ["system"]},
    "advisory_only": {"type": "boolean"},
    "measurement_basis": {"type": "string"},
    "backfilled_by_system": {"type": "boolean"}
  },
  "additionalProperties": true
}
