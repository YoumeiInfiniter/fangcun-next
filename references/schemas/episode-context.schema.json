{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Episode Context",
  "type": "object",
  "required": [
    "episode",
    "context_hash",
    "project_brief",
    "episode_outline",
    "source_evidence",
    "continuity_state",
    "selected_craft_modules",
    "format_profile",
    "advisory_timing"
  ],
  "properties": {
    "episode": {"type": "integer", "minimum": 1},
    "context_hash": {"type": "string", "minLength": 32},
    "project_brief": {"type": "object"},
    "adaptation_summary": {"type": "object"},
    "story_summary": {"type": "object"},
    "episode_outline": {"type": "object"},
    "source_evidence": {
      "type": "object",
      "required": ["chapter_ids", "events", "quotes", "raw_excerpts"],
      "properties": {
        "chapter_ids": {"type": "array", "items": {"type": "integer"}},
        "events": {"type": "array", "items": {"type": "object"}},
        "quotes": {"type": "array", "items": {"type": "object"}},
        "raw_excerpts": {"type": "array", "items": {"type": "object"}}
      }
    },
    "previous_approved_script": {"type": ["string", "null"]},
    "continuity_state": {"type": "object"},
    "writer_overrides": {"type": "array", "items": {"type": "object"}},
    "selected_craft_modules": {"type": "array", "items": {"type": "string"}},
    "format_profile": {"type": "string"},
    "advisory_timing": {
      "type": "object",
      "properties": {
        "minimum_seconds": {"type": "integer"},
        "preferred_seconds": {"type": ["array", "null"], "items": {"type": "integer"}},
        "outline_suggested_seconds": {"type": ["array", "null"], "items": {"type": "integer"}},
        "density_report": {"type": "object"}
      }
    },
    "review_focus": {"type": ["array", "null"], "items": {"type": "string"}}
  },
  "additionalProperties": true
}
