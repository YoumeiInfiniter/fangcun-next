#!/usr/bin/env bash
# SessionStart hook for fangcun plugin
# Detects fangcun drama projects by scanning for work products and injects bootstrap context.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# ─── Project Detection ───────────────────────────────────────────────
# Scan up to 4 levels deep for fangcun project signatures

HAS_FANGCUN=""
if [ -d "$(pwd)" ]; then
    HAS_FANGCUN=$(find . -maxdepth 4 \( \
        -path "*/projects/*/_cache/events.json" \
        -o -path "*/_cache/events.json" \
        -o -name "drama" -type d \
    \) 2>/dev/null | head -1)
fi

# No fangcun project → silent exit
if [ -z "$HAS_FANGCUN" ]; then
    exit 0
fi

# ─── Read fangcun bootstrap ──────────────────────────────────────────
fangcun_skill_content=$(cat "${PLUGIN_ROOT}/SKILL.md" 2>&1 || echo "")

# Build agent list from agents/ directory
agent_list=""
for agent_file in "${PLUGIN_ROOT}/agents"/*.md; do
    if [ -f "$agent_file" ]; then
        name=$(head -5 "$agent_file" | grep "^name:" | sed 's/name: *//')
        agent_list="${agent_list}  - ${name}\n"
    fi
done

# ─── JSON escape helper ──────────────────────────────────────────────
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

session_context="fangcun drama project detected (${HAS_FANGCUN}). Available skill: fangcun (drama adaptation). Available agents: $(echo -e "$agent_list"). Use Skill tool to load fangcun."
fangcun_escaped=$(escape_for_json "$session_context")

# ─── Output per-platform ─────────────────────────────────────────────
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
    printf '{\n  "additional_context": "%s"\n}\n' "$fangcun_escaped"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
    printf '{\n  "hookSpecificOutput": {\n    "additionalContext": "%s"\n  }\n}\n' "$fangcun_escaped"
else
    printf '{\n  "additionalContext": "%s"\n}\n' "$fangcun_escaped"
fi
